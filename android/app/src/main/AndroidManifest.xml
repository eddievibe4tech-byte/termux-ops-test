<?xml version="1.0" encoding="utf-8"?>
<!--
  hlops Companion APK manifest (issue #37, CI in #39).

  Privacy by design: the app declares NO INTERNET permission. It only
  launches Termux via intents (termux-am style) and reads bridge JSON /
  log files through SAF (ACTION_OPEN_DOCUMENT) — no MANAGE_EXTERNAL_STORAGE.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: we must see & launch Termux. -->
    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="com.termux.APPLICATION_PREFERENCES" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HlopsCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
